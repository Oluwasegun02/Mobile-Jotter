<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Widget Header -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📌 Pinned Jots"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Quick Diary Button -->
        <TextView
            android:id="@+id/widget_btn_diary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 Diary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#7C3AED"
            android:background="@drawable/widget_button_secondary_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:layout_marginEnd="6dp" />

        <!-- Quick Checklist Button -->
        <TextView
            android:id="@+id/widget_btn_checklist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ List"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#059669"
            android:background="@drawable/widget_button_tertiary_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:layout_marginEnd="6dp" />

        <!-- Quick Jot Button -->
        <TextView
            android:id="@+id/widget_btn_new_jot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Jot"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_primary_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginBottom="6dp" />

    <!-- Pinned Notes List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_pinned_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#00000000"
            android:dividerHeight="6dp" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/widget_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No pinned notes yet"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pin important notes or tap + to start jotting"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:gravity="center"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
